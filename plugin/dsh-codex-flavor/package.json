{
  "name": "dsh-codex-flavor",
  "version": "0.1.0",
  "private": true,
  "description": "Codex-flavored touches for the DeepSeek Harness Web GUI: keeps the DSH design system, adds subtle terminal/codex accents (code-block tokens, monospace stack, accent tuning).",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "theme"
      ]
    }
  }
}
